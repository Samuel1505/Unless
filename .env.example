# Names only. Copy to .env (never committed) and fill in what you need.

# Which Arc network the app talks to: "testnet" (the default) or "mainnet".
VITE_NETWORK=

# Optional: use a different retainer deployment than the one recorded in deployments/*.json.
# With an override the app does not know the deployment block, so it shows recent history only.
VITE_RETAINER_TESTNET=
VITE_RETAINER_MAINNET=
